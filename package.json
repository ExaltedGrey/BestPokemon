{
  "name": "pokemon-breath-of-the-dragon",
  "version": "1.0.0",
  "private": true,
  "description": "Pokémon: Breath of the Dragon — A 16-bit SNES Breath of Fire × Pokémon Fan RPG",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && SINGLE_FILE=1 vite build --outDir dist-single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.8"
  }
}
